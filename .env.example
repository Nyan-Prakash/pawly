EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_POSTHOG_API_KEY=your_posthog_key
# Optional. Defaults to US cloud; use https://eu.i.posthog.com for an EU project.
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=your_sentry_dsn
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_rc_ios_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_rc_android_key
# 'true' builds plans with the AI planner; anything else uses the rules-based generator.
EXPO_PUBLIC_ENABLE_ADAPTIVE_PLANNER=true
# 'true' offers live AI camera coaching in sessions. Off by default until the live-coach redesign lands.
EXPO_PUBLIC_ENABLE_LIVE_AI_TRAINER=false
APP_ENV=development
